<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_index.xml
    ======================================================================
    Tela Home (equivalente ao index.html do site): topo com carrossel
    (ViewPager2) reproduzindo o "hero-section", e abaixo a grade de
    "Especificações do Sistema" (specs-grid), dentro de um card de vidro
    (igual ao .container-box do site).

    ATENÇÃO - DEPENDÊNCIA NOVA NECESSÁRIA:
    Para o carrossel funcionar, usei um ViewPager2. Essa lib NÃO está no seu
    Gradle ainda. Adicione esta linha no bloco "dependencies" do seu
    build.gradle.kts (é da própria Google/AndroidX, estável e leve):

        implementation("androidx.viewpager2:viewpager2:1.1.0")

    Sem essa linha, este layout não vai compilar. Foi a única dependência
    nova que precisei adicionar - todo o resto do app usa só as libs que já
    estavam no seu Gradle original.

    Sobre o carrossel:
    O ViewPager2 precisa de um Adapter em Java (RecyclerView.Adapter) e de um
    layout de item (cada slide). Criei um layout de slide simples chamado
    "item_slide_carrossel.xml" (entregue junto com este arquivo) para você
    usar nesse Adapter.

    Imagens usadas (você precisa importar para res/drawable):
        slide_carrossel_01.png  -> assets/img/pages/index/slide-01.png
        slide_carrossel_02.png  -> assets/img/pages/index/slide-02.png
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    android:orientation="vertical"
    tools:context=".Index">

    <!-- Conteúdo rolável da tela -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================== HERO / CARROSSEL ===================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="460dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerCarrossel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Indicadores do carrossel, equivalente a .carousel-indicators -->
                <LinearLayout
                    android:id="@+id/containerDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="28dp"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="32dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_dot_ativo" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="20dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dot_inativo" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===================== CARD DE VIDRO: ESPECIFICAÇÕES ===================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="6dp"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtCategoriaTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/index_categoria_tag"
                    android:textAllCaps="true"
                    android:textColor="@color/soft_periwinkle"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtSecaoTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/index_secao_titulo"
                    android:textColor="@color/ink_black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtCategoriaTag"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Grade de cards (specs-grid). Empilhados verticalmente para telas de celular. -->
                <LinearLayout
                    android:id="@+id/containerSpecs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/txtSecaoTitulo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- ============ SPEC CARD 1 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec1_titulo"
                            android:src="@drawable/ic_medicao"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec1_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec1_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ============ SPEC CARD 2 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec2_titulo"
                            android:src="@drawable/ic_wifi"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec2_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec2_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ============ SPEC CARD 3 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec3_titulo"
                            android:src="@drawable/ic_alerta"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec3_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec3_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ============ SPEC CARD 4 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec4_titulo"
                            android:src="@drawable/ic_bateria"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec4_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec4_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ============ SPEC CARD 5 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec5_titulo"
                            android:src="@drawable/ic_grafico"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec5_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec5_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ============ SPEC CARD 6 ============ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_translucido"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/spec6_titulo"
                            android:src="@drawable/ic_seguranca"
                            app:tint="@color/dark_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec6_titulo"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/spec6_desc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BARRA DE NAVEGAÇÃO (ABAS) ===================== -->
    <LinearLayout
        android:id="@+id/barraNavegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_nav_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <!-- Aba: Início (tela atual — aba ativa) -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_casa"
                app:tint="@color/dark_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="@string/nav_inicio"
                android:textColor="@color/dark_teal"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aba: Dashboard -->
        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_grafico"
                app:tint="@color/air_force_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/nav_dashboard"
                android:textColor="@color/air_force_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aba: Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_perfil"
                app:tint="@color/air_force_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/nav_perfil"
                android:textColor="@color/air_force_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aba: Relatórios -->
        <LinearLayout
            android:id="@+id/navRelatorios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_relatorio"
                app:tint="@color/air_force_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/nav_relatorios"
                android:textColor="@color/air_force_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>