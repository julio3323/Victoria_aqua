<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_perfil.xml
    ======================================================================
    Equivalente a pages/perfil.html: banner no topo, avatar circular
    sobreposto, nome/usuário/e-mail, bio, metadados, grade de estatísticas
    e lista de atividade recente.

    Os modais de editar perfil / cortar foto / alterar banner do site (com
    Cropper.js) eu NÃO criei aqui, porque você pediu só estas 5 telas e eu
    não quero inventar fluxos extras que você não pediu. Se quiser, posso
    montar os modais (como Dialog/BottomSheet) depois, em outro arquivo.

    Imagem usada (você pode importar, opcional):
        res/drawable/perfil_banner_padrao.png -> sem equivalente fixo no
        site (lá o banner é dinâmico, trocado pelo próprio usuário). Deixei
        um gradiente (bg_perfil_banner) como aparência inicial, então essa
        imagem é só se você quiser uma foto de banner padrão pronta.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    android:fillViewport="true"
    tools:context=".Perfil">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===================== BANNER ===================== -->
        <FrameLayout
            android:id="@+id/perfilBanner"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_perfil_banner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_overlay_gradiente" />

            <LinearLayout
                android:id="@+id/btnEditarBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/perfil_btn_wallpaper"
                    android:src="@drawable/ic_imagem"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/perfil_btn_wallpaper"
                    android:textColor="@color/dark_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- ===================== AVATAR (sobreposto ao banner) ===================== -->
        <FrameLayout
            android:id="@+id/perfilAvatarSection"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/perfilBanner"
            app:layout_constraintStart_toStartOf="parent"
            android:translationY="-55dp">

            <View
                android:id="@+id/perfilAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:elevation="6dp" />

            <ImageButton
                android:id="@+id/btnEditarAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_btn_circular"
                android:contentDescription="@string/perfil_btn_wallpaper"
                android:elevation="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- ===================== NOME / USERNAME / BOTÃO EDITAR ===================== -->
        <LinearLayout
            android:id="@+id/infoBoxDestaque"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_info_box_destaque"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toBottomOf="@id/perfilAvatarSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/perfilNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_nome_carregando"
                android:textColor="@color/dark_teal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/perfilEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perfil_email_placeholder"
                android:textColor="@color/soft_periwinkle"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEditarPerfil"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@drawable/ic_lapis"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/perfil_btn_editar"
            android:textAllCaps="false"
            android:textColor="@color/dark_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            app:tint="@color/dark_teal"
            app:layout_constraintTop_toBottomOf="@id/infoBoxDestaque"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== BIO ===================== -->
        <TextView
            android:id="@+id/perfilBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card_translucido"
            android:lineSpacingExtra="4dp"
            android:padding="20dp"
            android:text="@string/perfil_bio_placeholder"
            android:textColor="@color/ink_black"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btnEditarPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== META INLINE (cidade, profissão, etc.) ===================== -->
        <LinearLayout
            android:id="@+id/perfilMetaInline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card_translucido"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/perfilBio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="cidade"
                    android:src="@drawable/ic_localizacao"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:id="@+id/perfilCidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="…"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="profissão"
                    android:src="@drawable/ic_maleta"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:id="@+id/perfilProfissao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="…"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="website"
                    android:src="@drawable/ic_link"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:id="@+id/perfilWebsite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/perfil_meta_website"
                    android:textColor="@color/soft_periwinkle"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="telefone"
                    android:src="@drawable/ic_telefone"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:id="@+id/perfilTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="…"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="data de nascimento"
                    android:src="@drawable/ic_aniversario"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:id="@+id/perfilDataNascimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/perfil_meta_data_indisponivel"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!--
            ===================== STATS GRID (2 colunas) =====================
            Usei LinearLayout (linhas + colunas com layout_weight) em vez de
            GridLayout porque a lib androidx.gridlayout NÃO está no Gradle de
            vocês, e eu não quero adicionar uma dependência nova sem vocês
            pedirem. Isso aqui usa só LinearLayout, que já vem no Android.
        -->
        <LinearLayout
            android:id="@+id/statsGridInner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card_translucido"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/perfilMetaInline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Linha 1: Consumo Mensal | Economia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Card: Consumo Mensal -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_translucido"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/perfil_stat_consumo_titulo"
                        android:src="@drawable/ic_gota"
                        app:tint="@color/soft_periwinkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="@string/perfil_stat_consumo_titulo"
                            android:textAllCaps="true"
                            android:textColor="@color/texto_secundario"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/statConsumo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/perfil_stat_consumo_valor"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card: Economia -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_translucido"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/perfil_stat_economia_titulo"
                        android:src="@drawable/ic_folha"
                        app:tint="@color/soft_periwinkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="@string/perfil_stat_economia_titulo"
                            android:textAllCaps="true"
                            android:textColor="@color/texto_secundario"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/statEconomia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/perfil_stat_economia_valor"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Linha 2: Eficiência | Pontuação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Card: Eficiência -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_translucido"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/perfil_stat_eficiencia_titulo"
                        android:src="@drawable/ic_grafico"
                        app:tint="@color/soft_periwinkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="@string/perfil_stat_eficiencia_titulo"
                            android:textAllCaps="true"
                            android:textColor="@color/texto_secundario"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/statEficiencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/perfil_stat_eficiencia_valor"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card: Pontuação -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_translucido"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/perfil_stat_pontuacao_titulo"
                        android:src="@drawable/ic_estrela"
                        app:tint="@color/soft_periwinkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="@string/perfil_stat_pontuacao_titulo"
                            android:textAllCaps="true"
                            android:textColor="@color/texto_secundario"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/statPontuacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/perfil_stat_pontuacao_valor"
                            android:textColor="@color/ink_black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ===================== ATIVIDADE RECENTE ===================== -->
        <LinearLayout
            android:id="@+id/perfilActivitySidebar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card_translucido"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/statsGridInner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/perfil_atividade_titulo"
                    android:src="@drawable/ic_historico"
                    app:tint="@color/dark_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/perfil_atividade_titulo"
                    android:textColor="@color/ink_black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:background="@color/campo_borda" />

            <!--
                Lista de atividades. No site isso é preenchido dinamicamente via
                JavaScript (id="activityList"). Aqui deixei o container pronto
                (id activityList) para você popular esses itens via Java, em vez
                de eu inventar um RecyclerView/Adapter que vocês não pediram ainda.
                Por enquanto fica vazio até ter dados reais.
            -->
            <LinearLayout
                android:id="@+id/activityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>